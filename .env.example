# Object storage (S3-compatible). Required: the feed has to live at a stable
# public URL, and the run state has to survive between runs.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Defaults to Yandex Object Storage. Any S3-compatible endpoint works.
S3_ENDPOINT=
S3_REGION=

# PostgreSQL. Optional — without it the feed is still built and published, you
# just lose the price history and the join between leads and programmes.
# Per-client overrides: POSTGRES_HOST_<CLIENT> falls back to POSTGRES_HOST.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Telegram reporting. Optional.
TELEGRAM_BOT_TOKEN_FEEDS=
TELEGRAM_CHAT_ID_FEEDS=

# Relay. Needed when the environment the job runs in cannot reach an external
# API directly — ours reaches neither api.telegram.org nor openrouter.ai. The
# relay holds the model API key, so the job itself is deployed without one.
RELAY_URL=
RELAY_SECRET=
# Derived from RELAY_URL when omitted.
OPENROUTER_RELAY_URL=

# Model access for ad copy and creative. Set this where the job can reach the
# provider directly; leave it empty and set the relay instead where it cannot.
OPENROUTER_API_KEY=

# Yandex Direct API, used only by eval/wordstat_compare.py to settle wording
# questions by search demand. Per-account: YANDEX_DIRECT_TOKEN_<CLIENT>.
YANDEX_DIRECT_TOKEN=
