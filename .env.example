# Object storage (S3-compatible)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# PostgreSQL. Per-client overrides are optional: POSTGRES_HOST_<CLIENT>
# falls back to POSTGRES_HOST, and each client gets its own schema.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Telegram reporting.
TELEGRAM_BOT_TOKEN_FEEDS=
TELEGRAM_CHAT_ID_FEEDS=

# Optional relay, used when the Telegram API is not reachable from the
# environment the job runs in.
RELAY_URL=
RELAY_SECRET=

# Image generation.
OPENROUTER_API_KEY=
